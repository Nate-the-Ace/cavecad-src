From 60cc5cbcfaf483bec69fc0105295e68b51362453 Mon Sep 17 00:00:00 2001
From: Nathan Schonegg <nschonegg@banning-eng.com>
Date: Wed, 19 Aug 2026 18:16:34 -0400
Subject: [PATCH 1/5] CaveCAD: rebrand QCAD Community as a dedicated cave
 mapping app

Own application name (CaveCAD) and settings override (CaveCAD3.ini)
give it its own per-user data folder and scripts location, fully
separate from any QCAD / QCAD Professional install on the machine.
Bundle name/display name follow. The Cave Survey suite installs into
Application Support/QCAD/CaveCAD/scripts via the suite's publish.sh.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 src/run/Info.plist              |   4 +-
 src/run/main.cpp                |   9 +-
 src/scripts/scripts.qrc         | 534 ++++++++++++++++----------------
 src/scripts/scripts_release.qrc | 176 +++++------
 4 files changed, 364 insertions(+), 359 deletions(-)

diff --git a/src/run/Info.plist b/src/run/Info.plist
index d6639b3d..93c6e0bd 100644
--- a/src/run/Info.plist
+++ b/src/run/Info.plist
@@ -8,9 +8,9 @@
 	<string>APPL</string>
 
 	<key>CFBundleName</key>
-	<string>QCAD</string>
+	<string>CaveCAD</string>
 	<key>CFBundleDisplayName</key>
-	<string>QCAD</string>
+	<string>CaveCAD</string>
 	<key>CFBundleIdentifier</key>
 	<string>org.qcad.QCAD</string>
 	<key>CFBundleExecutable</key>
diff --git a/src/run/main.cpp b/src/run/main.cpp
index f3b61666..34e3a746 100644
--- a/src/run/main.cpp
+++ b/src/run/main.cpp
@@ -137,9 +137,14 @@ int main(int argc, char *argv[]) {
 #endif
 
     // these are defaults:
+    // CaveCAD: QCAD Community rebranded as a dedicated cave mapping
+    // application. Its own application name gives it its own settings
+    // (CaveCAD3.ini) and its own per-user scripts folder, so it never
+    // collides with a QCAD / QCAD Professional install on the same
+    // machine.
     qApp->setOrganizationName("QCAD");
     qApp->setOrganizationDomain("QCAD.org");
-    qApp->setApplicationName("QCAD");
+    qApp->setApplicationName("CaveCAD");
     qApp->setApplicationVersion(RSettings::getVersionString());
 
     // alternative path for QCAD3.ini:
@@ -166,7 +171,7 @@ int main(int argc, char *argv[]) {
         }
     }
 
-    RSettings::setApplicationNameOverride("QCAD3");
+    RSettings::setApplicationNameOverride("CaveCAD3");
 
     // Auto scale up user interface for high res displays under Windows:
 //#ifdef Q_OS_WIN
