#ifndef SHARED_RC
#define SHARED_RC

#include <windows.h>
/* generated by src/run/CMakeInclude.txt from the VERSION file */
#include "cavecad_version.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

#define VER_FILEVERSION             CAVECAD_VERSION_MAJOR,CAVECAD_VERSION_MINOR,CAVECAD_VERSION_REV,CAVECAD_VERSION_BUILD
#define VER_FILEVERSION_STR         CAVECAD_VERSION_STRING

#define VER_PRODUCTVERSION          CAVECAD_VERSION_MAJOR,CAVECAD_VERSION_MINOR,CAVECAD_VERSION_REV,CAVECAD_VERSION_BUILD
#define VER_PRODUCTVERSION_STR      CAVECAD_VERSION_STRING

#define VER_COMPANYNAME_STR         "CaveCAD project"
#define VER_FILEDESCRIPTION_STR     "CaveCAD"
#define VER_INTERNALNAME_STR        "CaveCAD"
#define VER_LEGALCOPYRIGHT_STR      "Copyright (c) RibbonSoft, GmbH; CaveCAD modifications (c) 2026 CaveCAD project"
#define VER_LEGALTRADEMARKS1_STR    "Free software under the GNU GPL v3. QCAD is a trademark of RibbonSoft GmbH."
#define VER_LEGALTRADEMARKS2_STR    VER_LEGALTRADEMARKS1_STR
#define VER_PRODUCTNAME_STR         "CaveCAD"

#define VER_COMPANYDOMAIN_STR       "https://github.com/Nate-the-Ace/cavecad-src"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_FILEVERSION
PRODUCTVERSION VER_PRODUCTVERSION
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",        VER_COMPANYNAME_STR
            VALUE "FileDescription",    VER_FILEDESCRIPTION_STR
            VALUE "FileVersion",        VER_FILEVERSION_STR
            VALUE "InternalName",       VER_INTERNALNAME_STR
            VALUE "LegalCopyright",     VER_LEGALCOPYRIGHT_STR
            VALUE "LegalTrademarks1",   VER_LEGALTRADEMARKS1_STR
            VALUE "LegalTrademarks2",   VER_LEGALTRADEMARKS2_STR
            VALUE "OriginalFilename",   VER_ORIGINALFILENAME_STR
            VALUE "ProductName",        VER_PRODUCTNAME_STR
            VALUE "ProductVersion",     VER_PRODUCTVERSION_STR
            //VALUE "Rev",     I_SVNREV
            //VALUE "Date",     I_SVN_CLOCKDATE
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
#endif // SHARED_RC
